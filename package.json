{
  "name": "rasuko",
  "version": "0.1.0",
  "description": "A blank, unlimited creation canvas — pages as reusable Views",
  "author": "RYSPA",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheAnimatrix/Rasuko.git"
  },
  "bugs": {
    "url": "https://github.com/TheAnimatrix/Rasuko/issues"
  },
  "homepage": "https://github.com/TheAnimatrix/Rasuko#readme",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./out/main/index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/ensure-electron.mjs",
    "dev": "node scripts/ensure-electron.mjs && electron-vite dev",
    "build": "node scripts/ensure-electron.mjs && electron-vite build",
    "preview": "node scripts/ensure-electron.mjs && electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && svelte-check --tsconfig ./tsconfig.web.json",
    "check": "svelte-check --tsconfig ./tsconfig.web.json",
    "test": "node scripts/chat-history-test.mjs && node scripts/chat-runtime-test.mjs && node scripts/workspace-tools-test.mjs && node scripts/workspace-integrity-test.mjs && node scripts/record-actions-test.mjs && node scripts/capabilities-test.mjs && node scripts/editor-test.mjs && node scripts/renderer-chat-test.mjs",
    "test:ui": "npm run build && node scripts/ui-smoke.mjs && node scripts/interface-ui-test.mjs",
    "test:live": "npm run build && node scripts/kanban-live-test.mjs",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.85.1"
  },
  "devDependencies": {
    "@iconify-json/mingcute": "1.2.8",
    "@iconify/svelte": "5.2.2",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "24.13.5",
    "bits-ui": "2.19.2",
    "clsx": "2.1.1",
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "sv-router": "0.19.0",
    "svelte": "^5.57.0",
    "svelte-check": "4.7.6",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.7.2",
    "vite": "7.3.6"
  },
  "build": {
    "appId": "com.ryspa.rasuko",
    "productName": "Rasuko",
    "copyright": "Copyright © 2026 RYSPA",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!**/*.map"
    ],
    "npmRebuild": false,
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Productivity",
      "executableName": "rasuko"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
